generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PaymentTokenStatus {
  CREATED
  PENDING
  SUCCESSFUL
  FAILED
  DECLINED
  EXPIRED
  ERROR
}

enum CreditTransactionStatus {
  PENDING
  SUCCESSFUL
  FAILED
}

enum TransactionType {
  grant
  spend
  refund
  adjustment
}

enum InteractionAction {
  LIKE
  DISLIKE
  SKIP
}

enum InteractionSource {
  FEED
  PROFILE
  BACKFILL
}

enum AiFeatureKey {
  profile_analyzer
  photo_spotlight
  match_radar
  bio_rewrite_studio
}

enum AiUnlockStatus {
  active
  expired
}

model user {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions session[]
  accounts account[]

  userCredits   user_credits?
  transactions  credit_transaction[]
  paymentTokens payment_token[]
  sentGifts     gift_send[]
  giftInventory gift_inventory[]

  matchInteractions match_interaction[]
  conversations     conversation[]

  aiAnalyses ai_analysis[]
  aiUnlocks  ai_unlock[]
}

model session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model user_credits {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model payment_token {
  id           String             @id @default(cuid())
  userId       String
  status       PaymentTokenStatus
  gatewayUid   String?            @unique
  gatewayToken String?            @unique
  trackingId   String?            @unique
  rawPayload   Json?
  errorMessage String?
  amountCents  Int
  currency     String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user         user                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions credit_transaction[]

  @@index([userId])
}

model credit_transaction {
  id             String                  @id @default(cuid())
  userId         String
  type           TransactionType
  amount         Int
  status         CreditTransactionStatus @default(SUCCESSFUL)
  reason         String?
  paymentTokenId String?                 @unique
  createdAt      DateTime                @default(now())

  user         user           @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentToken payment_token? @relation(fields: [paymentTokenId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
}

model gift_catalog {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  imagePath  String
  priceCoins Int
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  giftSends gift_send[]
  inventory gift_inventory[]
}

model gift_send {
  id                    String   @id @default(cuid())
  senderUserId          String
  recipientDatingUserId Int
  giftId                String
  priceCoins            Int
  createdAt             DateTime @default(now())

  sender user         @relation(fields: [senderUserId], references: [id], onDelete: Cascade)
  gift   gift_catalog @relation(fields: [giftId], references: [id], onDelete: Restrict)

  @@index([senderUserId, createdAt])
  @@index([recipientDatingUserId, createdAt])
  @@index([giftId])
}

model gift_inventory {
  id        String   @id @default(cuid())
  userId    String
  giftId    String
  quantity  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user user         @relation(fields: [userId], references: [id], onDelete: Cascade)
  gift gift_catalog @relation(fields: [giftId], references: [id], onDelete: Restrict)

  @@unique([userId, giftId])
  @@index([userId, updatedAt])
  @@index([giftId])
}

model match_interaction {
  id             String            @id @default(cuid())
  userId         String
  targetDatingId Int
  action         InteractionAction
  source         InteractionSource @default(FEED)
  createdAt      DateTime          @default(now())

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetDatingId, action])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, targetDatingId])
}

model conversation {
  id               String    @id @default(cuid())
  userId           String
  peerDatingId     Int
  lastMessageAt    DateTime?
  lastReadAt       DateTime?
  lastSeenLegacyId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user     user      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages message[]

  @@unique([userId, peerDatingId])
  @@index([userId, lastMessageAt(sort: Desc)])
}

model message {
  id             String    @id @default(cuid())
  conversationId String
  legacyId       String?
  senderDatingId Int
  body           String
  idempotencyKey String?
  createdAt      DateTime  @default(now())
  deliveredAt    DateTime?
  readAt         DateTime?

  conversation conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, legacyId])
  @@unique([conversationId, idempotencyKey])
  @@index([conversationId, createdAt])
}

model ai_analysis {
  id         String       @id @default(cuid())
  userId     String
  feature    AiFeatureKey
  subjectKey String
  inputHash  String
  output     Json
  tokensIn   Int          @default(0)
  tokensOut  Int          @default(0)
  costCoins  Int          @default(0)
  createdAt  DateTime     @default(now())
  expiresAt  DateTime?

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, feature, subjectKey, inputHash])
  @@index([userId, feature, createdAt])
  @@index([expiresAt])
}

model ai_rate_bucket {
  userId   String
  feature  AiFeatureKey
  windowAt DateTime
  count    Int          @default(0)

  @@id([userId, feature, windowAt])
  @@index([windowAt])
}

model ai_unlock {
  id           String         @id @default(cuid())
  userId       String
  startAt      DateTime       @default(now())
  expiresAt    DateTime
  status       AiUnlockStatus @default(active)
  durationDays Int
  costCoins    Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, expiresAt])
  @@index([expiresAt])
}
